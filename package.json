{
  "name": "dsh-resource-radar",
  "version": "1.0.0",
  "description": "Resource Radar (资源雷达) — a freebie / deal / open-source / news aggregation workbench plugin for DeepSeek Harness, with a Host-side CORS-free RSS collector.",
  "type": "module",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "rss", "freebie", "radar", "aggregator"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
